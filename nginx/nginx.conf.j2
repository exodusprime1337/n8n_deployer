events {}

http {
    # Docker embedded DNS — runtime resolution
    resolver 127.0.0.11 valid=10s;

    # Global error_page declaration is allowed here
    error_page 502 503 504 /50x.html;

    server {
        listen 80;
        server_name {{ N8N_HOSTNAME }} {{ SUPABASE_HOSTNAME }} {{ QDRANT_HOSTNAME }};

        location / {
            return 301 https://$host$request_uri;
        }

        # local internal error page for this server
        location = /50x.html {
            internal;
            return 503 "Service temporarily unavailable\n";
        }
    }
    
    server {
        listen 443 ssl;
        server_name {{ N8N_HOSTNAME }};

        ssl_certificate /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;

        # Backend defined INSIDE server (valid scope)
        set $n8n_backend http://n8n:5678;

        # WebSocket tuning
        proxy_buffering off;
        proxy_request_buffering off;

        location / {
            proxy_pass $n8n_backend;

            # WebSocket support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            # Preserve client headers
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Long-running workflows
            proxy_read_timeout 3600;
            proxy_send_timeout 3600;

            proxy_next_upstream error timeout;
        }

        # internal error page for this server
        location = /50x.html {
            internal;
            return 503 "Service temporarily unavailable\n";
        }
    }

    server {
        listen 443 ssl;
        server_name {{ QDRANT_HOSTNAME }};

        ssl_certificate /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;

        set $qdrant_backend http://qdrant:6333;

        client_max_body_size 50M;

        location / {
            proxy_pass $qdrant_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600;
            proxy_send_timeout 3600;
            proxy_next_upstream error timeout;
        }

        location = /50x.html {
            internal;
            return 503 "Service temporarily unavailable\n";
        }
    }
}
